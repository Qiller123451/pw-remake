<?xml version="1.0" encoding="utf-8"?>
<!-- The Godot packages come with the Godot .NET editor (GodotSharp/Tools/nupkgs); nuget.org is the normal source.
     If your Godot is elsewhere, the editor finds its packages by itself - this file only matters for command-line
     builds without internet (CI, the build machine of this project). -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
