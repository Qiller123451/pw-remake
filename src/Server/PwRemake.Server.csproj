<Project Sdk="Microsoft.NET.Sdk">
  <!-- The dedicated server of networked games (docs/MULTIPLAYER.md "Dedicated server"): a NetHost without a player. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>PwRemake.Server</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Net/PwRemake.Net.csproj" />
  </ItemGroup>
</Project>
